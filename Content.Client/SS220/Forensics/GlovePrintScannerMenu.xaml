<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'glove-print-scanner-interface-title'}"
               MinSize="400 250"
               SetSize="400 400">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <Button Name="Clear"
                Access="Public"
                TextAlign="Center"
                Text="{Loc 'glove-print-scanner-interface-clear'}" />
        <Label Name="TargetLabel" />
        <Label Name="SampleLabel" />
        <Label Name="MatchLabel" />
        <Label Text="{Loc 'glove-print-scanner-interface-traces'}" />
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <Label Name="TracesLabel" VerticalAlignment="Top" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
