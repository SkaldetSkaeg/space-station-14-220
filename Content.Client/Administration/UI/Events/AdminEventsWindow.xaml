<ui:FancyWindow xmlns="https://spacestation14.io"
                xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
                Title="{Loc admin-events-title}"
                MinSize="760 420" SetSize="1050 650">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal">
            <Label Name="EventsStatus" HorizontalExpand="True"/>
            <Button Name="RefreshButton" Text="{Loc admin-events-refresh}" Access="Public"/>
        </BoxContainer>
        <TabContainer Name="Tabs" VerticalExpand="True">
            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                <PanelContainer Name="RulesPane" MinWidth="250" HorizontalExpand="True" StyleClasses="PanelDeep">
                    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
                        <Label Text="{Loc admin-events-current-schedulers}"/>
                        <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                            <BoxContainer Name="RulesList" Orientation="Vertical" SeparationOverride="4"/>
                        </ScrollContainer>
                        <Button Name="AddRuleButton" Text="{Loc admin-events-add}" ToolTip="{Loc admin-events-add-title}" Disabled="True"/>
                        <Button Name="StopRuleButton" Text="{Loc admin-events-stop}" ToolTip="{Loc admin-events-stop-tooltip}" Disabled="True"/>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer Name="TablePane" MinWidth="440" HorizontalExpand="True" SizeFlagsStretchRatio="2" StyleClasses="PanelDeep">
                    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
                        <PanelContainer StyleClasses="PanelDark" Margin="0 0 0 4">
                            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
                                <Label Text="{Loc admin-events-tables}"/>
                                <RichTextLabel Name="SelectedRuleLabel" HorizontalExpand="True"/>
                                <Label Name="NextAttemptLabel" ToolTip="{Loc admin-events-next-attempt-tooltip}"/>
                                <RichTextLabel Text="{Loc admin-events-tables-hint}" HorizontalExpand="True"/>
                            </BoxContainer>
                        </PanelContainer>
                        <ScrollContainer Name="EntriesScroll" HScrollEnabled="False" VerticalExpand="True">
                            <BoxContainer Name="EntriesList" Orientation="Vertical" SeparationOverride="6"/>
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                <PanelContainer MinWidth="250" HorizontalExpand="True" StyleClasses="PanelDeep">
                    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
                        <Label Text="{Loc admin-events-current-events}"/>
                        <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                            <BoxContainer Name="EventRulesList" Orientation="Vertical" SeparationOverride="4"/>
                        </ScrollContainer>
                        <Button Name="AddEventButton" Text="{Loc admin-events-add}" Disabled="True"/>
                        <Button Name="StopEventButton" Text="{Loc admin-events-stop}" ToolTip="{Loc admin-events-stop-tooltip}" Disabled="True"/>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer MinWidth="440" HorizontalExpand="True" SizeFlagsStretchRatio="2" StyleClasses="PanelDeep">
                    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
                        <Label Text="{Loc admin-events-history}"/>
                        <RichTextLabel Text="{Loc admin-events-history-hint}"/>
                        <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                            <BoxContainer Name="HistoryList" Orientation="Vertical" SeparationOverride="4"/>
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </TabContainer>
        <RichTextLabel Name="ActionStatus" HorizontalExpand="True" Visible="False"/>
    </BoxContainer>
</ui:FancyWindow>
